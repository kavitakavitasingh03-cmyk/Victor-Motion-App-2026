rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Global hardened primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Entity validation helpers
    function isValidUserProfile(data) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.displayName is string &&
             data.displayName.size() >= 1 &&
             data.displayName.size() <= 80 &&
             (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 500)) &&
             data.subscriptionTier is string &&
             data.subscriptionTier in ['free', 'pro', 'studio'] &&
             data.preferredExportQuality is string &&
             data.preferredExportQuality in ['720p', '1080p', '2K', '4K'] &&
             data.preferredFps is int &&
             data.preferredFps in [30, 60, 120] &&
             data.cloudBackupEnabled is bool &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    function isValidVideoProject(data) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.title is string &&
             data.title.size() >= 1 &&
             data.title.size() <= 120 &&
             data.aspectRatio is string &&
             data.aspectRatio in ['9:16', '16:9', '1:1', '4:5'] &&
             data.resolution is string &&
             data.resolution in ['720p', '1080p', '2K', '4K'] &&
             data.fps is int &&
             data.fps in [30, 60, 120] &&
             data.durationMs is int &&
             data.durationMs >= 0 &&
             data.durationMs <= 86400000 &&
             data.layerCount is int &&
             data.layerCount >= 0 &&
             data.layerCount <= 200 &&
             data.layersJson is string &&
             data.layersJson.size() >= 2 &&
             data.layersJson.size() <= 200000 &&
             (!('templateOriginId' in data) || (data.templateOriginId is string && data.templateOriginId.size() <= 128)) &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    function isValidCreatorPreset(data) {
      return data.authorId is string &&
             data.authorId.size() >= 1 &&
             data.authorId.size() <= 128 &&
             data.authorName is string &&
             data.authorName.size() >= 1 &&
             data.authorName.size() <= 80 &&
             data.title is string &&
             data.title.size() >= 1 &&
             data.title.size() <= 100 &&
             data.category is string &&
             data.category in ['Cinematic', 'Velocity', 'Transitions', 'MotionFX', 'TextAnim', 'ColorGrade'] &&
             data.description is string &&
             data.description.size() <= 400 &&
             data.isPublished is bool &&
             data.isPremium is bool &&
             data.effectSummary is string &&
             data.effectSummary.size() <= 300 &&
             data.presetPayloadJson is string &&
             data.presetPayloadJson.size() >= 2 &&
             data.presetPayloadJson.size() <= 50000 &&
             data.likesCount is int &&
             data.likesCount >= 0 &&
             data.likesCount <= 10000000 &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    // 1. User Studio Profile
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if isOwner(userId);

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().keys().hasAll([
                         'userId', 'displayName', 'subscriptionTier',
                         'preferredExportQuality', 'preferredFps',
                         'cloudBackupEnabled', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'displayName', 'photoUrl', 'subscriptionTier',
                         'preferredExportQuality', 'preferredFps',
                         'cloudBackupEnabled', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidUserProfile(incoming());

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'displayName', 'photoUrl', 'subscriptionTier',
                         'preferredExportQuality', 'preferredFps',
                         'cloudBackupEnabled', 'updatedAt'
                       ]);

      allow delete: if isOwner(userId) && isValidId(userId);

      // 2. Cloud-Backed Video Projects
      match /projects/{projectId} {
        allow get: if isOwner(userId) && isValidId(projectId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(projectId) &&
                         incoming().keys().hasAll([
                           'userId', 'title', 'aspectRatio', 'resolution',
                           'fps', 'durationMs', 'layerCount', 'layersJson',
                           'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'title', 'aspectRatio', 'resolution',
                           'fps', 'durationMs', 'layerCount', 'layersJson',
                           'templateOriginId', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidVideoProject(incoming());

        allow update: if isOwner(userId) &&
                         isValidId(projectId) &&
                         isValidVideoProject(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'title', 'aspectRatio', 'resolution',
                           'fps', 'durationMs', 'layerCount', 'layersJson',
                           'templateOriginId', 'updatedAt'
                         ]);

        allow delete: if isOwner(userId) && isValidId(projectId);
      }
    }

    // 3. Community & Creator Marketplace Presets
    match /presets/{presetId} {
      allow get: if isSignedIn() &&
                    isValidId(presetId) &&
                    (existing().isPublished == true || existing().authorId == request.auth.uid);

      // Client queries must filter by whereEqualTo("isPublished", true) or whereEqualTo("authorId", uid)
      allow list: if isSignedIn() &&
                     (existing().isPublished == true || existing().authorId == request.auth.uid);

      allow create: if isSignedIn() &&
                       isValidId(presetId) &&
                       incoming().authorId == request.auth.uid &&
                       incoming().likesCount == 0 &&
                       incoming().keys().hasAll([
                         'authorId', 'authorName', 'title', 'category',
                         'description', 'isPublished', 'isPremium',
                         'effectSummary', 'presetPayloadJson', 'likesCount',
                         'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'authorId', 'authorName', 'title', 'category',
                         'description', 'isPublished', 'isPremium',
                         'effectSummary', 'presetPayloadJson', 'likesCount',
                         'createdAt', 'updatedAt'
                       ]) &&
                       isValidCreatorPreset(incoming());

      allow update: if isSignedIn() &&
                       isValidId(presetId) &&
                       isValidCreatorPreset(incoming()) &&
                       incoming().authorId == existing().authorId &&
                       incoming().createdAt == existing().createdAt && (
                         // Action 1: Author updates preset metadata or payload
                         (
                           existing().authorId == request.auth.uid &&
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'title', 'category', 'description', 'isPublished',
                             'isPremium', 'effectSummary', 'presetPayloadJson', 'updatedAt'
                           ])
                         ) ||
                         // Action 2: Authenticated creator likes a published preset (+1)
                         (
                           existing().isPublished == true &&
                           incoming().likesCount == existing().likesCount + 1 &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'updatedAt'])
                         )
                       );

      allow delete: if isSignedIn() &&
                       isValidId(presetId) &&
                       existing().authorId == request.auth.uid;
    }
  }
}
